{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    { 
      "src": "*.py", 
      "use": "@vercel/python", 
      "config": { "runtime": "python3.9" } 
    }
  ],
  "routes": [
    {
      "src": "/compiler",
      "dest": "compiler.py"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
